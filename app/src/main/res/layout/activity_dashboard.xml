<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- Main Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#F5F7FA">

        <!-- Modern Top Header with Gradient -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:background="@drawable/gradient_header_bg"
            android:elevation="4dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="24dp">

            <!-- Hamburger Menu Button -->
            <ImageView
                android:id="@+id/btn_menu"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="12dp"
                android:src="@drawable/ic_menu"
                android:contentDescription="Menu"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/white"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true" />

            <!-- App Title and Subtitle -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_centerInParent="true"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎓"
                    android:textSize="48sp"
                    android:includeFontPadding="false"
                    android:textColor="@color/white"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TPC Management"
                    android:textSize="24sp"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Training &amp; Placement Cell"
                    android:textSize="14sp"
                    android:textColor="#E8EAF6"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif-light" />

            </LinearLayout>

        </RelativeLayout>

        <!-- Main Content Area with Elevated Cards -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Statistics Cards with Modern Design -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="8dp"
                    android:backgroundTint="@color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📊 Statistics Overview"
                            android:textSize="18sp"
                            android:textColor="@color/black"
                            android:textStyle="bold"
                            android:layout_marginBottom="16dp"
                            android:fontFamily="sans-serif-medium" />

                        <!-- Stats Grid -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <!-- Row 1 -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:baselineAligned="false"
                                android:layout_marginBottom="12dp">

                                <!-- Total Students Card -->
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:minHeight="110dp"
                                    android:layout_weight="1"
                                    android:orientation="vertical"
                                    android:background="@drawable/stat_card_blue"
                                    android:paddingTop="14dp"
                                    android:paddingBottom="14dp"
                                    android:paddingStart="16dp"
                                    android:paddingEnd="16dp"
                                    android:gravity="center"
                                    android:layout_marginEnd="6dp"
                                    android:elevation="4dp">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="👥"
                                        android:textSize="32sp"
                                        android:includeFontPadding="false"
                                        android:layout_marginBottom="4dp"
                                        android:textColor="@color/white" />

                                    <TextView
                                        android:id="@+id/tv_total_students"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="0"
                                        android:textSize="28sp"
                                        android:textColor="@color/white"
                                        android:textStyle="bold"
                                        android:fontFamily="sans-serif-medium" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Students"
                                        android:textSize="13sp"
                                        android:textColor="@color/white"
                                        android:layout_marginTop="2dp"
                                        android:fontFamily="sans-serif-light" />

                                </LinearLayout>

                                <!-- Placed Students Card -->
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:minHeight="110dp"
                                    android:layout_weight="1"
                                    android:orientation="vertical"
                                    android:background="@drawable/stat_card_green"
                                    android:paddingTop="14dp"
                                    android:paddingBottom="14dp"
                                    android:paddingStart="16dp"
                                    android:paddingEnd="16dp"
                                    android:gravity="center"
                                    android:layout_marginStart="6dp"
                                    android:elevation="4dp">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="✅"
                                        android:textSize="32sp"
                                        android:includeFontPadding="false"
                                        android:layout_marginBottom="4dp"
                                        android:textColor="@color/white" />

                                    <TextView
                                        android:id="@+id/tv_placed_students"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="0"
                                        android:textSize="28sp"
                                        android:textColor="@color/white"
                                        android:textStyle="bold"
                                        android:fontFamily="sans-serif-medium" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Placed"
                                        android:textSize="13sp"
                                        android:textColor="@color/white"
                                        android:layout_marginTop="2dp"
                                        android:fontFamily="sans-serif-light" />

                                </LinearLayout>

                            </LinearLayout>

                            <!-- Row 2 -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:baselineAligned="false">

                                <!-- Companies Card -->
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:minHeight="110dp"
                                    android:layout_weight="1"
                                    android:orientation="vertical"
                                    android:background="@drawable/stat_card_purple"
                                    android:paddingTop="14dp"
                                    android:paddingBottom="14dp"
                                    android:paddingStart="16dp"
                                    android:paddingEnd="16dp"
                                    android:gravity="center"
                                    android:layout_marginEnd="6dp"
                                    android:elevation="4dp">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="🏢"
                                        android:textSize="32sp"
                                        android:includeFontPadding="false"
                                        android:layout_marginBottom="4dp"
                                        android:textColor="@color/white" />

                                    <TextView
                                        android:id="@+id/tv_total_companies"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="0"
                                        android:textSize="28sp"
                                        android:textColor="@color/white"
                                        android:textStyle="bold"
                                        android:fontFamily="sans-serif-medium" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Companies"
                                        android:textSize="13sp"
                                        android:textColor="@color/white"
                                        android:layout_marginTop="2dp"
                                        android:fontFamily="sans-serif-light" />

                                </LinearLayout>

                                <!-- Placement Rate Card -->
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:minHeight="110dp"
                                    android:layout_weight="1"
                                    android:orientation="vertical"
                                    android:background="@drawable/stat_card_orange"
                                    android:paddingTop="14dp"
                                    android:paddingBottom="14dp"
                                    android:paddingStart="16dp"
                                    android:paddingEnd="16dp"
                                    android:gravity="center"
                                    android:layout_marginStart="6dp"
                                    android:elevation="4dp">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="📈"
                                        android:textSize="32sp"
                                        android:includeFontPadding="false"
                                        android:layout_marginBottom="4dp"
                                        android:textColor="@color/white" />

                                    <TextView
                                        android:id="@+id/tv_placement_rate"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="0%"
                                        android:textSize="28sp"
                                        android:textColor="@color/white"
                                        android:textStyle="bold"
                                        android:fontFamily="sans-serif-medium" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Success Rate"
                                        android:textSize="13sp"
                                        android:textColor="@color/white"
                                        android:layout_marginTop="2dp"
                                        android:fontFamily="sans-serif-light" />

                                </LinearLayout>

                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- Quick Actions Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="8dp"
                    android:backgroundTint="@color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⚡ Quick Actions"
                            android:textSize="18sp"
                            android:textColor="@color/black"
                            android:textStyle="bold"
                            android:layout_marginBottom="16dp"
                            android:fontFamily="sans-serif-medium" />

                        <!-- Action Buttons -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_add_student"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:text="➕ Add New Student"
                            android:textSize="15sp"
                            android:textColor="@color/white"
                            android:backgroundTint="#2196F3"
                            app:cornerRadius="12dp"
                            app:icon="@android:drawable/ic_input_add"
                            app:iconTint="@color/white"
                            android:textAllCaps="false"
                            android:layout_marginBottom="12dp"
                            android:elevation="4dp"
                            android:fontFamily="sans-serif-medium" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_add_company"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:text="➕ Add New Company"
                            android:textSize="15sp"
                            android:textColor="@color/white"
                            android:backgroundTint="#4CAF50"
                            app:cornerRadius="12dp"
                            app:icon="@android:drawable/ic_input_add"
                            app:iconTint="@color/white"
                            android:textAllCaps="false"
                            android:layout_marginBottom="12dp"
                            android:elevation="4dp"
                            android:fontFamily="sans-serif-medium" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- Upcoming Drives Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="8dp"
                    android:backgroundTint="@color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📅 Upcoming Drives"
                            android:textSize="18sp"
                            android:textColor="@color/black"
                            android:textStyle="bold"
                            android:layout_marginBottom="16dp"
                            android:fontFamily="sans-serif-medium" />

                        <!-- Drive Items -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:background="@drawable/drive_item_bg"
                            android:padding="16dp"
                            android:layout_marginBottom="10dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🏢 TCS"
                                android:textSize="16sp"
                                android:textColor="@color/black"
                                android:textStyle="bold"
                                android:layout_marginBottom="4dp"
                                android:fontFamily="sans-serif-medium" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Campus Drive • Nov 15, 2025"
                                android:textSize="14sp"
                                android:textColor="#616161"
                                android:fontFamily="sans-serif-light" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:background="@drawable/drive_item_bg"
                            android:padding="16dp"
                            android:layout_marginBottom="10dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🏢 Infosys"
                                android:textSize="16sp"
                                android:textColor="@color/black"
                                android:textStyle="bold"
                                android:layout_marginBottom="4dp"
                                android:fontFamily="sans-serif-medium" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Pre-placement Talk • Nov 20, 2025"
                                android:textSize="14sp"
                                android:textColor="#616161"
                                android:fontFamily="sans-serif-light" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:background="@drawable/drive_item_bg"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🏢 Wipro"
                                android:textSize="16sp"
                                android:textColor="@color/black"
                                android:textStyle="bold"
                                android:layout_marginBottom="4dp"
                                android:fontFamily="sans-serif-medium" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Technical Round • Nov 25, 2025"
                                android:textSize="14sp"
                                android:textColor="#616161"
                                android:fontFamily="sans-serif-light" />

                        </LinearLayout>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

            </LinearLayout>

        </ScrollView>

    </LinearLayout>

    <!-- Dark Overlay -->
    <View
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:visibility="gone"
        android:clickable="true" />

    <!-- Sidebar Navigation (Improved Design) -->
    <LinearLayout
        android:id="@+id/sidebar"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/white"
        android:elevation="16dp"
        android:fitsSystemWindows="true"
        android:translationX="-280dp">

        <!-- Sidebar Header with Gradient -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:orientation="vertical"
            android:background="@drawable/gradient_header_bg"
            android:padding="24dp"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎓"
                android:textSize="56sp"
                android:includeFontPadding="false"
                android:textColor="@color/white"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TPC Portal"
                android:textSize="22sp"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Training &amp; Placement"
                android:textSize="13sp"
                android:textColor="#E8EAF6"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-light" />

        </LinearLayout>

        <!-- Navigation Items -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="16dp"
                android:paddingBottom="16dp">

                <!-- Dashboard -->
                <LinearLayout
                    android:id="@+id/ll_dashboard"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:background="?attr/selectableItemBackground">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📊"
                        android:textSize="28sp"
                        android:includeFontPadding="false"
                        android:layout_marginEnd="20dp"
                        android:textColor="#5C6BC0" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dashboard"
                        android:textSize="16sp"
                        android:textColor="#5C6BC0"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium" />

                </LinearLayout>

                <!-- Students -->
                <LinearLayout
                    android:id="@+id/ll_nav_students"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:background="?attr/selectableItemBackground">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="👥"
                        android:textSize="28sp"
                        android:includeFontPadding="false"
                        android:layout_marginEnd="20dp"
                        android:textColor="#212121" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Students"
                        android:textSize="16sp"
                        android:textColor="#212121"
                        android:fontFamily="sans-serif" />

                </LinearLayout>

                <!-- Companies -->
                <LinearLayout
                    android:id="@+id/ll_nav_companies"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:background="?attr/selectableItemBackground">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🏢"
                        android:textSize="28sp"
                        android:includeFontPadding="false"
                        android:layout_marginEnd="20dp"
                        android:textColor="#212121" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Companies"
                        android:textSize="16sp"
                        android:textColor="#212121"
                        android:fontFamily="sans-serif" />

                </LinearLayout>

                <!-- Placed Students -->
                <LinearLayout
                    android:id="@+id/ll_nav_placed"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:background="?attr/selectableItemBackground">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✅"
                        android:textSize="28sp"
                        android:includeFontPadding="false"
                        android:layout_marginEnd="20dp"
                        android:textColor="#212121" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Placed Students"
                        android:textSize="16sp"
                        android:textColor="#212121"
                        android:fontFamily="sans-serif" />

                </LinearLayout>

            </LinearLayout>

        </ScrollView>

    </LinearLayout>

</FrameLayout>
